# ══════════════════════════════════════════════════════════════════════════════
# O3 Car Spaa — Environment Variables Template (Production Launch Ready)
# ══════════════════════════════════════════════════════════════════════════════

# ─── Application Runtime ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
APP_BASE_URL=https://api.o3carspaa.com
CLIENT_URL=https://app.o3carspaa.com
SERVER_URL=https://api.o3carspaa.com

# ─── Database Configuration (MySQL 8.0+) ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=o3_car_spa
DB_USER=o3_app_user
DB_PASSWORD=your_strong_db_password_here

# ─── Security & Authentication ────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=generate_a_very_strong_random_secret_at_least_64_characters
JWT_EXPIRES_IN=7d

# ─── Payment Gateway (Razorpay) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# ─── Cloud Storage (Cloudinary - Optional for Object Media) ───────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── SMS / OTP Gateway (MSG91) ────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=O3SPAA
MSG91_WHATSAPP_NUMBER=
ADMIN_WHATSAPP_NUMBER=919876543210

# ─── WhatsApp Engine (Baileys / Multi-Device) ─────────────────────────────────
# Directory for persisting Baileys auth credentials
BAILEYS_AUTH_DIR=./auth_info_baileys
