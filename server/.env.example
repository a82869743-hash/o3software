# ══════════════════════════════════════════════════════════════════════════════
# O3 Car Spaa — Master Environment Configuration Template
# Multi-Franchise Automotive Studio ERP & AI Leads Platform
# ══════════════════════════════════════════════════════════════════════════════
# NOTE: Copy this file to .env and fill in your values.
# NEVER commit your actual .env file with secrets into version control.

# ─── 1. Application Runtime ───────────────────────────────────────────────────
# Allowed values: development | staging | production | test
NODE_ENV=production
# Application HTTP server listening port (Default: 5000)
PORT=5000
# Full public URL of the backend API server
SERVER_URL=https://api.o3carspaa.com
# Base URL alias for OAuth & webhook callbacks
APP_BASE_URL=https://api.o3carspaa.com
# Public frontend URL allowed for CORS authentication and cookies
CLIENT_URL=https://app.o3carspaa.com

# ─── 2. MySQL Database Configuration (MySQL 8.0+) ─────────────────────────────
# Target: Hostinger VPS or local managed MySQL instance
DB_HOST=localhost
DB_PORT=3306
DB_NAME=o3_car_spa
DB_USER=o3_app_user
DB_PASSWORD=your_strong_mysql_password_here

# ─── 3. Cryptography, Security & Authentication ───────────────────────────────
# JWT Secret Key for user & employee session tokens (Must be >= 32 characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d
# AES-256-GCM Master Encryption Key for encrypting stored WhatsApp credentials in DB
# Generate with: openssl rand -hex 32 (Must be 32 bytes / 64 hex characters)
ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_aes_256_gcm_credential_vault

# ─── 4. WhatsApp (Meta WhatsApp Cloud API — direct, no middleman) ─────────────
# See INTEGRATIONS_SETUP.md. Leave blank → messages are only logged (sandbox).
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent System User token (Business Settings → System users → Generate token: whatsapp_business_messaging + whatsapp_business_management)
WHATSAPP_ACCESS_TOKEN=
# Any long random string — paste the same value in Meta → WhatsApp → Configuration → Webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App → Settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
# Approved UTILITY template used when the customer has not messaged in 24h.
# Body must be: "Hi {{1}}, {{2}} — O3 Car Spaa"  (2 variables: name, message)
WHATSAPP_UTILITY_TEMPLATE=o3_service_update
WHATSAPP_TEMPLATE_LANG=en

# AiSensy Partner Gateway (Optional Alternative BSP)
AISENSY_API_KEY=

# Baileys Unofficial Web Demo Gateway — DEMO ONLY. Keep false in production (number-ban risk).
ENABLE_BAILEYS_DEMO=false
DEMO_WHITELIST=

# ─── 5. AI Leads Agent & WhatsApp auto-reply ─────────────────────────────────
# One Groq key runs both the leads agent and WhatsApp auto-replies (console.groq.com → API keys, free tier).
# Free tier ≈ 30 replies/min and 1,000/day. If Groq fails or the limit is hit, the studio's own
# rule-based agent answers from live data (services, prices, slots, knowledge base) — never left unanswered.
# Leave GROQ_API_KEY empty to use only the rule-based agent.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low = fastest; short sales replies don't need more
GROQ_REASONING_EFFORT=low

# AI pictures for new services/packages (Google AI Studio → Get API key). Optional — without it the app
# picks a matching picture from its built-in library by service name.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ─── 7. SMS — OTP only (login / register / forgot password) ───────────────────
# OTP_PROVIDER=2factor (default) or msg91
OTP_PROVIDER=2factor
# 2Factor.in API key (2factor.in → Dashboard). Optional: your DLT-approved template name
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=
# MSG91 alternative (needs a DLT-approved OTP template)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
ADMIN_WHATSAPP_NUMBER=919876543210
# Notification queue controls
MESSAGES_ENABLED=true
NOTIFICATION_SANDBOX=false

# ─── 8. Email Dispatch (SMTP / Gmail) ─────────────────────────────────────────
# Email is PAUSED: nothing is sent until EMAIL_ENABLED=true (and the SMTP keys below are set)
EMAIL_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=notifications@o3carspaa.com
SMTP_PASS=your_email_password
SMTP_FROM="O3 Car Spaa Notifications" <notifications@o3carspaa.com>
# Gmail Alternative Fallback
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── 9. Cloud Media Storage (Cloudinary - Optional) ───────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── 10. Puppeteer PDF Generation (Hostinger VPS) ──────────────────────────────
# In Linux VPS, install chromium: apt-get install -y chromium-browser
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=

# ─── Phase 1 additions ───
# Show OTP in API response for local testing only (never in production)
OTP_DEV_ECHO=false
# Mobile app / separate API host build (client): VITE_SERVER_ORIGIN=https://api.example.com
